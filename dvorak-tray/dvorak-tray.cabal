cabal-version:       2.2

name:                dvorak-tray
version:             0.1.0.0
build-type:          Simple

executable dvorak-tray
  hs-source-dirs:      src
  main-is:             Main.hs
  other-modules:       TrayIcon
  default-language:    Haskell2010
  build-depends:       base >= 4.7 && < 5
                     , dbus
                     , unix
  ghc-options:         -Wall
                       -Wcompat
                       -Widentities
                       -Wincomplete-record-updates
                       -Wincomplete-uni-patterns
                       -Wmissing-export-lists
                       -Wmissing-home-modules
                       -Wpartial-fields
                       -Wredundant-constraints
